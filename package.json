  },
  "dependencies": {
    "@slidev/cli": "^52.0.0",
    "@slidev/theme-default": "^0.25.0",
    "rough-notation": "^0.5.1",
    "roughjs": "^4.6.6",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.61.1"
  }
}
